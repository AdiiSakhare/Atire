{{!-- Closing banner (mockup "Wear What Speaks for You.") --}}
<section class="section container">
  <div class="closing" data-reveal>
    <div class="closing__body">
      <h2 class="closing__title" data-split>{{home.closing.title}}</h2>
      <p class="closing__text">{{home.closing.text}}</p>
      <a class="btn-arrow btn-arrow--light" href="{{home.closing.url}}">
        <span class="btn-arrow__label">{{home.closing.cta}}</span>
        <span class="btn-arrow__circle">{{icon "arrow-up-right"}}</span>
      </a>
    </div>
    <div class="closing__media" data-parallax><img src="{{home.closing.image}}" alt="Atire tees on a rack" loading="lazy" /></div>
  </div>
</section>
