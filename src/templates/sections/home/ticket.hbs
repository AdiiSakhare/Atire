{{!-- Ticket-shaped cashback banner with countdown (mockup). JS: js/sections/countdown.js --}}
<section class="container ticket-wrap" data-reveal>
  <div class="ticket">
    <div class="ticket__copy">
      <p class="ticket__title">{{home.ticket.title}}</p>
      <p class="ticket__sub">{{home.ticket.subtitle}}</p>
    </div>
    <button class="ticket__code" type="button" data-copy="{{home.ticket.code}}" aria-label="Copy code {{home.ticket.code}}">
      <span class="ticket__code-label">USE CODE</span>
      <span class="ticket__code-value">{{home.ticket.code}}</span>
      <span class="ticket__tag" aria-hidden="true">%</span>
    </button>
    <div class="ticket__timer" data-countdown data-ends-at="{{home.ticket.endsAt}}" aria-label="Offer ends in">
      <div><strong data-cd="d">00</strong><span>DAYS</span></div>
      <div><strong data-cd="h">00</strong><span>HRS</span></div>
      <div><strong data-cd="m">00</strong><span>MINS</span></div>
      <div><strong data-cd="s">00</strong><span>SECS</span></div>
    </div>
  </div>
</section>
