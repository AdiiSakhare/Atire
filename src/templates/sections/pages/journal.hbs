{{!-- Journal (blog) index. Shopify: blog.journal --}}
{{> snippets/page-hero eyebrow="The Atire Journal" title="Stories, style & behind the print" sub="Style guides, culture and the people who wear the conversation."}}
<section class="container journal">
  <nav class="journal__cats no-scrollbar" aria-label="Topics">
    <button class="chip-toggle" type="button" aria-pressed="true" data-journal-cat="all">All</button>
    {{#each categories}}<button class="chip-toggle" type="button" aria-pressed="false" data-journal-cat="{{this}}">{{this}}</button>{{/each}}
  </nav>

  <a class="post-featured" href="/article.html?slug={{featured.slug}}" data-post data-category="{{featured.category}}">
    <span class="post-featured__media"><img src="{{featured.image}}" alt="" /></span>
    <span class="post-featured__body">
      <span class="post__meta"><b>{{featured.category}}</b> · {{featured.date}} · {{featured.read}}</span>
      <span class="post-featured__title">{{featured.title}}</span>
      <span class="post__excerpt">{{featured.excerpt}}</span>
      <span class="section-head__link">Read story<span>{{icon "arrow-up-right"}}</span></span>
    </span>
  </a>

  <div class="posts">
    {{#each posts}}
      <a class="post" href="/article.html?slug={{this.slug}}" data-post data-category="{{this.category}}" data-reveal>
        <span class="post__media"><img src="{{this.image}}" alt="" loading="lazy" /></span>
        <span class="post__meta"><b>{{this.category}}</b> · {{this.read}}</span>
        <span class="post__title">{{this.title}}</span>
        <span class="post__excerpt">{{this.excerpt}}</span>
      </a>
    {{/each}}
  </div>

  <div class="journal__news">
    <div><h2 class="h-display-sm">Get the good stuff first</h2><p class="text-muted">New stories, drops and members-only combos. Once a week, max.</p></div>
    <form class="journal__form" data-newsletter>
      <input type="email" placeholder="you@email.com" required aria-label="Email" />
      <button class="btn btn--dark" type="submit">Subscribe</button>
    </form>
  </div>
</section>
