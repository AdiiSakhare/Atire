{{!-- 404 — “Human not found”, on brand with the developer tee --}}
<section class="container nf">
  <div class="nf__copy">
    <p class="eyebrow section-head__eyebrow">Error 404</p>
    <h1 class="nf__title">Page not found.<br /><span>Unlike our tees.</span></h1>
    <p class="text-muted nf__text">The page you’re looking for went for a chai break and never came back. Try a search or head somewhere fun.</p>
    <form class="faq-search nf__search" action="/shop.html" role="search">
      <span>{{icon "search"}}</span>
      <input type="search" name="q" placeholder="Search for tees, hoodies…" aria-label="Search" />
    </form>
    <div class="nf__links">
      <a class="btn-arrow" href="/"><span class="btn-arrow__label">Back to Home</span><span class="btn-arrow__circle">{{icon "arrow-up-right"}}</span></a>
      <a class="chip-toggle" href="/shop.html?c=bestseller">Bestsellers</a>
      <a class="chip-toggle" href="/shop.html?c=new">New drops</a>
      <a class="chip-toggle" href="/faq.html">Help center</a>
    </div>
  </div>
  <div class="nf__art">
    <img src="/assets/images/placeholders/cat-developers.jpg" alt="Error 404 Human Not Found tee" />
    <span class="nf__sticker">404</span>
  </div>
</section>
