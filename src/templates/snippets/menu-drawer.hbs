{{!-- Mobile navigation drawer --}}
<aside class="drawer drawer--left menu-drawer" id="menu-drawer" data-drawer aria-label="Menu" aria-hidden="true">
  <div class="drawer__head">
    <a href="/" aria-label="Atire home" class="menu-drawer__logo">{{> snippets/logo}}</a>
    <button class="icon-btn icon-btn--sm" type="button" data-drawer-close aria-label="Close menu">{{icon "close"}}</button>
  </div>
  <div class="drawer__body" data-lenis-prevent>
    {{#each site.nav}}
      {{#if this.mega}}
        <details class="accordion">
          <summary class="accordion__summary">{{this.title}}<span class="icon">{{icon "chevron-down"}}</span></summary>
          <div class="accordion__inner menu-drawer__group">
            {{#each this.mega.columns}}
              <p class="menu-drawer__title">{{this.title}}</p>
              {{#each this.links}}<a href="/shop.html?q={{this}}">{{this}}</a>{{/each}}
            {{/each}}
          </div>
        </details>
      {{else}}
        <a class="accordion accordion__summary" href="{{this.url}}">{{this.title}}<span class="icon">{{icon "chevron-right"}}</span></a>
      {{/if}}
    {{/each}}

    <div class="menu-drawer__cards">
      {{#each site.nav.[0].mega.cards}}
        <a class="mega-card" href="{{this.url}}">
          <img src="{{this.image}}" alt="" loading="lazy" />
          <span class="mega-card__label">{{this.title}}</span>
        </a>
      {{/each}}
    </div>
  </div>
  <div class="drawer__foot menu-drawer__foot">
    <a href="/account.html">{{icon "user"}} Account</a>
    <a href="/wishlist.html">{{icon "heart"}} Wishlist</a>
    <a href="/track-order.html">{{icon "truck"}} Track order</a>
  </div>
</aside>
