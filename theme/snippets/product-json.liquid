{%- comment -%}
  One product as JSON, in the shape the storefront scripts expect (same as src/data/products.js):
  options[0] = Color (objects with swatch), options[1] = Size (strings), images carry the colour
  of the variant that uses them, prices are integer minor units.
  Usage: {% render 'product-json', product: product %}
  Metafields (custom): tagline, card_title, badge, rating_value, rating_count, collection_label,
  chips (list), highlights (json), story (json).
{%- endcomment -%}
{%- liquid
  assign color_option = product.options_with_values | where: 'name', 'Color' | first
  assign size_option = product.options_with_values | where: 'name', 'Size' | first
-%}
{
  "id": {{ product.id | json }},
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "card_title": {{ product.metafields.custom.card_title.value | default: product.title | json }},
  "tagline": {{ product.metafields.custom.tagline.value | json }},
  "vendor": {{ product.vendor | json }},
  "product_type": {{ product.type | json }},
  "collection": {{ product.metafields.custom.collection_label.value | default: product.collections.first.title | json }},
  "tags": {{ product.tags | json }},
  "badge": {{ product.metafields.custom.badge.value | json }},
  "url": {{ product.url | json }},
  "price": {{ product.price | json }},
  "compare_at_price": {{ product.compare_at_price | json }},
  "rating": { "value": {{ product.metafields.custom.rating_value.value | default: 0 | json }}, "count": {{ product.metafields.custom.rating_count.value | default: 0 | json }} },
  "images": [
    {%- for image in product.images -%}
      {%- assign image_color = '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.featured_image.id == image.id -%}{%- assign image_color = variant.option1 -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      { "src": {{ image | image_url: width: 1000 | json }}, "alt": {{ image.alt | default: product.title | json }}, "color": {{ image_color | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "options": [
    { "name": "Color", "values": [
      {%- for value in color_option.values -%}
        {%- capture swatch %}{% render 'swatch-color', value: value %}{% endcapture -%}
        {%- assign lower = value.name | downcase -%}
        { "name": {{ value.name | json }}, "swatch": {{ swatch | strip | json }}, "light": {% if lower == 'off white' or lower == 'beige' or lower == 'grey melange' or lower == 'white' %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ] },
    { "name": "Size", "values": {{ size_option.values | json }} }
  ],
  "variants": [
    {%- for variant in product.variants -%}
      { "id": {{ variant.id }}, "title": {{ variant.title | json }}, "option1": {{ variant.option1 | json }}, "option2": {{ variant.option2 | json }}, "sku": {{ variant.sku | json }}, "price": {{ variant.price }}, "compare_at_price": {{ variant.compare_at_price | json }}, "available": {{ variant.available }}, "inventory_quantity": {{ variant.inventory_quantity | default: 0 }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "metafields": {
    "chips": {{ product.metafields.custom.chips.value | json }},
    "highlights": {{ product.metafields.custom.highlights.value | json }},
    "story": {{ product.metafields.custom.story.value | json }}
  }
}
