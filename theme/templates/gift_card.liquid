{%- comment -%} Gift card page (Shopify requires this Liquid template). Normal layout. {%- endcomment -%}
{%- assign gc_balance = gift_card.balance | money_without_trailing_zeros -%}
{%- assign gc_initial = gift_card.initial_value | money_without_trailing_zeros -%}
<header class="page-hero page-hero--center">
  <div class="container">
    <p class="eyebrow page-hero__eyebrow">{{ shop.name }}</p>
    <h1 class="page-hero__title" data-split>Your gift card</h1>
    <p class="page-hero__sub">{% if gift_card.enabled == false %}This gift card has been disabled.{% elsif gift_card.expired %}This gift card expired on {{ gift_card.expires_on | date: '%-d %b %Y' }}.{% else %}Use the code below at checkout.{% endif %}</p>
  </div>
</header>

<section class="container gift-card" style="max-width: 560px; margin-inline: auto; text-align: center; padding-block: 2rem 4rem;">
  <p class="eyebrow">Balance</p>
  <p class="h-display-sm">{{ gc_balance }}</p>
  {%- if gift_card.balance != gift_card.initial_value -%}<p class="text-muted">Original value {{ gc_initial }}</p>{%- endif -%}

  {%- assign gc_code = gift_card.code | format_code -%}
  <button class="welcome__code" type="button" data-copy="{{ gc_code }}" style="margin-block: 1.5rem;">{{ gc_code }} <span>{% render 'icon', name: 'copy' %}</span></button>

  {%- if gift_card.expires_on -%}<p class="text-muted">Expires {{ gift_card.expires_on | date: '%-d %b %Y' }}</p>{%- endif -%}
  {%- if gift_card.pass_url -%}<p><a class="btn btn--outline btn--sm btn--pill" href="{{ gift_card.pass_url }}">Add to Apple Wallet</a></p>{%- endif -%}

  <div class="gift-card__qr" style="margin-block: 1.5rem; display: flex; justify-content: center;">
    <div data-gift-qr data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="Gift card QR code"></div>
  </div>

  <div style="display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap;">
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Start shopping</a>
    <button class="btn btn--outline" type="button" onclick="window.print()">Print</button>
  </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer crossorigin="anonymous"></script>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    var el = document.querySelector('[data-gift-qr]');
    if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 160, height: 160 });
  });
</script>
