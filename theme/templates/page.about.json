{
  "sections": {
    "hero": {
      "type": "about-hero",
      "settings": {
        "eyebrow": "Our Story",
        "title": "We make tees that say the thing you were thinking.",
        "text": "Atire started with one oversized tee, one inside joke and a group chat that wouldn’t stop asking where it was from.",
        "placeholder": "hero-same-different.jpg"
      }
    },
    "manifesto": {
      "type": "about-manifesto",
      "settings": {
        "text": "Clothes should start conversations. Not small talk — real ones. The “where’s that from?”, the “that’s so me”, the stranger on the metro who laughs at your back. That’s the whole point."
      }
    },
    "timeline": {
      "type": "about-timeline",
      "settings": {
        "eyebrow": "How it started",
        "title": "From a group chat to 2 lakh+ wardrobes"
      },
      "blocks": {
        "milestone-1": {
          "type": "milestone",
          "settings": {
            "year": "2022",
            "title": "The first print",
            "text": "Fifty tees, screen printed in a borrowed studio. Sold out to friends of friends in four days."
          }
        },
        "milestone-2": {
          "type": "milestone",
          "settings": {
            "year": "2023",
            "title": "Textees go viral",
            "text": "One “I’m here for the degree” photo later, our inbox became a full-time job."
          }
        },
        "milestone-3": {
          "type": "milestone",
          "settings": {
            "year": "2024",
            "title": "The couple edit",
            "text": "You kept buying two of everything. So we started designing them as pairs."
          }
        },
        "milestone-4": {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "2 lakh+ fits shipped",
            "text": "Our own print floor, 600+ original designs and a community that names half our drops."
          }
        }
      },
      "block_order": [
        "milestone-1",
        "milestone-2",
        "milestone-3",
        "milestone-4"
      ]
    },
    "values": {
      "type": "about-values",
      "settings": {
        "eyebrow": "What we stand for",
        "title": "Four rules we don’t break"
      },
      "blocks": {
        "value-1": {
          "type": "value",
          "settings": {
            "icon": "sparkle",
            "title": "Original, always",
            "text": "Every print is drawn in-house. No templates, no stock graphics, no copies."
          }
        },
        "value-2": {
          "type": "value",
          "settings": {
            "icon": "shield",
            "title": "Built heavy",
            "text": "240 GSM combed cotton tees and 320 GSM fleece. Made to survive 100 washes and your weekends."
          }
        },
        "value-3": {
          "type": "value",
          "settings": {
            "icon": "return",
            "title": "Fair & easy",
            "text": "Honest prices, 7-day returns and real humans on WhatsApp when something isn’t right."
          }
        },
        "value-4": {
          "type": "value",
          "settings": {
            "icon": "heart",
            "title": "Community-made",
            "text": "Half our drops start as your comments. You vote, we print."
          }
        }
      },
      "block_order": [
        "value-1",
