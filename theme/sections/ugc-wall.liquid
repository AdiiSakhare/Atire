{%- comment -%} Staggered community photo wall. Photos are grouped into columns by the "Column" setting. {%- endcomment -%}
<section class="section container ugc-wall">
  {% render 'section-head', eyebrow: section.settings.eyebrow, title: section.settings.title, sub: section.settings.sub, link: section.settings.link, link_label: section.settings.link_label, center: true %}
  <div class="ugc-wall__grid">
    {%- for col in (1..8) -%}
      <div class="ugc-wall__col" style="--col: {{ forloop.index0 }}" data-ugc-col>
        {%- for block in section.blocks -%}{%- if block.settings.column == col -%}
          <a class="ugc-wall__item" href="{{ block.settings.link | default: section.settings.link | default: '#' }}" aria-label="View on Instagram" {{ block.shopify_attributes }}>{% render 'responsive-image', image: block.settings.image, fallback: block.settings.placeholder, alt: '', width: 500, widths: '250, 400, 500', sizes: '(min-width: 990px) 12vw, 25vw' %}<span>{% render 'icon', name: 'instagram' %}</span></a>
        {%- endif -%}{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Photo wall",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#WearAtire" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Straight from the community" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Tag @atire.india for a chance to be featured — and a ₹500 voucher." },
    { "type": "url", "id": "link", "label": "Instagram link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow on Instagram" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder", "label": "Placeholder image (asset file name or URL)" },
        { "type": "range", "id": "column", "label": "Column", "min": 1, "max": 8, "step": 1, "default": 1 },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Photo wall", "blocks": [{ "type": "photo" }, { "type": "photo" }] }]
}
{% endschema %}
