{%- comment -%} Sign in. Shopify classic customer accounts (email + password). {%- endcomment -%}
<section class="container account">
  <div class="auth">
    <div class="auth__media">
      {% render 'responsive-image', image: section.settings.image, fallback: section.settings.placeholder, alt: '', width: 800, sizes: '(min-width: 990px) 50vw, 0px' %}
      <div class="auth__media-copy">
        <p class="eyebrow">Members get more</p>
        <ul>
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check-circle' %} {{ block.settings.text }}</li>{%- endfor -%}
        </ul>
      </div>
    </div>
    <div class="auth__panel">
      <div class="auth__tabs" role="tablist">
        <a role="tab" aria-selected="true" href="{{ routes.account_login_url }}">Sign in</a>
        <a role="tab" aria-selected="false" href="{{ routes.account_register_url }}">Create account</a>
      </div>

      {%- form 'customer_login', class: 'auth__form', novalidate: 'novalidate' -%}
        <h1 class="auth__title">Welcome back</h1>
        <p class="text-muted">Sign in to see your orders, addresses and wishlist.</p>
        {%- if form.errors -%}<p class="summary__msg is-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="input"><span>Email</span><input name="customer[email]" type="email" required autocomplete="email" value="{{ form.email }}"></label>
        <label class="input"><span>Password</span><input name="customer[password]" type="password" required autocomplete="current-password"></label>
        <button class="btn btn--dark btn--block btn--lg" type="submit">Sign in</button>
        <p class="auth__fine"><a href="#recover" data-recover-toggle>Forgot your password?</a></p>
        <p class="auth__fine">By continuing you agree to our <a href="{{ pages.terms.url | default: '/pages/terms' }}">Terms</a> &amp; <a href="{{ pages.privacy.url | default: '/pages/privacy' }}">Privacy Policy</a>.</p>
      {%- endform -%}

      {%- form 'recover_customer_password', class: 'auth__form', id: 'recover' -%}
        <h2 class="auth__title">Reset your password</h2>
        {%- if form.posted_successfully? -%}<p class="summary__msg is-ok" role="status">We’ve sent you an email with a link to reset your password.</p>{%- endif -%}
        {%- if form.errors -%}<p class="summary__msg is-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="input"><span>Email</span><input name="email" type="email" required autocomplete="email"></label>
        <button class="btn btn--outline btn--block" type="submit">Send reset link</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sign in",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder image (asset file name or URL)", "default": "tee-couple-roast.jpg" }
  ],
  "blocks": [{ "type": "perk", "name": "Perk", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "10% off your first order" }] }]
}
{% endschema %}
