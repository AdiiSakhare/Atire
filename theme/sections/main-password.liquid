{%- comment -%} Storefront password page content. Used by layout/password.liquid. {%- endcomment -%}
<section class="container account" style="min-height: 100vh; display: grid; place-items: center; padding-block: 3rem;">
  <div class="auth__panel" style="max-width: 480px; width: 100%;">
    {%- render 'logo' -%}
    <h1 class="auth__title">{{ section.settings.title | default: shop.name }}</h1>
    {%- assign message = shop.password_message | default: section.settings.message -%}
    <p class="text-muted">{{ message }}</p>

    {%- if section.settings.show_signup -%}
      {%- form 'customer', class: 'auth__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <h2 class="auth__title">{{ section.settings.signup_title }}</h2>
        {%- if form.posted_successfully? -%}<p class="summary__msg is-ok" role="status">Thanks for subscribing — we’ll be in touch.</p>{%- endif -%}
        {%- if form.errors -%}<p class="summary__msg is-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="input"><span>Email</span><input name="contact[email]" type="email" required autocomplete="email" value="{{ form.email }}"></label>
        <button class="btn btn--dark btn--block btn--lg" type="submit">{{ section.settings.signup_button }}</button>
      {%- endform -%}
    {%- endif -%}

    {%- form 'storefront_password', class: 'auth__form' -%}
      <h2 class="auth__title">{{ section.settings.password_title }}</h2>
      {%- if form.errors -%}<p class="summary__msg is-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="input"><span>Password</span><input name="password" type="password" required autocomplete="current-password"></label>
      <button class="btn btn--outline btn--block" type="submit">Enter</button>
    {%- endform -%}

    <p class="auth__fine"><a href="{{ routes.root_url }}admin">Are you the store owner? Log in</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "info": "Empty = store name." },
    { "type": "textarea", "id": "message", "label": "Fallback message", "default": "We’re putting the finishing touches on something good. Leave your email and we’ll let you know the moment we open.", "info": "Shown when no password message is set in Online Store > Preferences." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "signup_title", "label": "Sign-up heading", "default": "Be first in line" },
    { "type": "text", "id": "signup_button", "label": "Sign-up button", "default": "Notify me" },
    { "type": "text", "id": "password_title", "label": "Password heading", "default": "Have the password?" }
  ],
  "presets": [{ "name": "Password page" }]
}
{% endschema %}
