{%- comment -%}
  "Complete the look" buy-together bundle. First item is the current product.
  JS: js/sections/product-bundle.js. NOTE: the bundle discount is displayed here and
  applied client-side in the prototype; in Shopify it needs a real automatic discount (Phase 7).
{%- endcomment -%}
<section class="section container bundle" data-bundle data-bundle-discount="{{ section.settings.discount | times: 100 }}">
  <div class="section-head">
    <div>
      <h2 class="h-display-sm" data-reveal>{{ section.settings.title }}</h2>
      <p class="section-head__sub" data-reveal>{{ section.settings.sub }}</p>
    </div>
  </div>

  <div class="bundle__card" data-reveal>
    <ul class="bundle__items">
      {%- assign extras = section.blocks | where: 'type', 'item' -%}
      {%- for entry in (0..extras.size) -%}
        {%- if forloop.first -%}
          {%- assign p = product -%}
        {%- else -%}
          {%- assign idx = forloop.index0 | minus: 1 -%}
          {%- assign p = extras[idx].settings.product -%}
        {%- endif -%}
        {%- if p != blank -%}
          {%- assign size_option = p.options_with_values | where: 'name', 'Size' | first -%}
          <li class="bundle__item" data-bundle-item data-handle="{{ p.handle }}" data-price="{{ p.price }}" data-compare="{{ p.compare_at_price | at_least: p.price }}">
            <label class="bundle__check">
              <input type="checkbox" checked {% if forloop.first %}disabled{% endif %} data-bundle-check>
              <span class="bundle__checkbox">{% render 'icon', name: 'check' %}</span>
              <span class="visually-hidden">Include {{ p.title | escape }}</span>
            </label>
            <a class="bundle__media" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.featured_image.alt }}{%- endif -%}</a>
            <div class="bundle__info">
              <p class="bundle__label">{% if forloop.first %}This item{% else %}{{ p.type }}{% endif %}</p>
              <a class="bundle__title" href="{{ p.url }}">{% render 'product-title', product: p %}</a>
              {% render 'price', product: p, tag: 'div' %}
              <select class="select bundle__size" aria-label="Size for {{ p.title | escape }}" data-bundle-size>
                {%- for value in size_option.values -%}<option{% if value == 'M' %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
              </select>
            </div>
          </li>
          {%- unless forloop.last -%}<li class="bundle__plus" aria-hidden="true">{% render 'icon', name: 'plus' %}</li>{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="bundle__summary">
      <p class="bundle__summary-label">Bundle price for <span data-bundle-count>{{ extras.size | plus: 1 }}</span> items</p>
      <div class="bundle__total">
        <span class="bundle__total-price" data-bundle-total></span>
        <s class="price__compare" data-bundle-compare></s>
      </div>
      <p class="bundle__save" data-bundle-save></p>
      <button class="btn btn--primary btn--block btn--lg" type="button" data-bundle-add>Add Bundle to Cart</button>
      <p class="bundle__fine">Extra {{ section.settings.discount | times: 100 | money_without_trailing_zeros }} off applies on {{ extras.size | plus: 1 }} items.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Complete the look" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Bought together by 1,200+ people. Save ₹200 when you take all three." },
    { "type": "number", "id": "discount", "label": "Bundle discount (₹)", "default": 200, "info": "Display only — create the matching automatic discount in Shopify admin." }
  ],
  "blocks": [{ "type": "item", "name": "Bundle product", "limit": 3, "settings": [{ "type": "product", "id": "product", "label": "Product" }] }],
  "presets": [{ "name": "Complete the look", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
