<section class="container account">
  <div class="auth__panel" style="max-width: 480px; margin: 0 auto;">
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      <h1 class="auth__title">Choose a new password</h1>
      {%- if form.errors -%}<p class="summary__msg is-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="input"><span>New password</span><input name="customer[password]" type="password" required autocomplete="new-password"></label>
      <label class="input"><span>Confirm password</span><input name="customer[password_confirmation]" type="password" required autocomplete="new-password"></label>
      <button class="btn btn--dark btn--block btn--lg" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
