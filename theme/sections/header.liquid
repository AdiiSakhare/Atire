{%- comment -%}
  Header, search overlay and mobile menu drawer.
  Menu: Navigation → section setting. Mega panels are "Mega menu" blocks whose
  "Menu item title" matches a top-level link title.
{%- endcomment -%}
{%- assign menu = linklists[section.settings.menu] -%}
{%- assign wishlist_url = pages.wishlist.url | default: '/pages/wishlist' -%}

<header class="site-header" data-header>
  <div class="site-header__bar container">
    <div class="site-header__left">
      <button class="icon-btn site-header__burger" type="button" data-drawer-open="menu-drawer" aria-label="Open menu">
        {% render 'icon', name: 'menu' %}
      </button>

      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {%- for link in menu.links -%}
            {%- assign mega = null -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.parent == link.title -%}{%- assign mega = block -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            <li class="site-nav__item{% if mega %} has-mega{% endif %}" {% if mega %}data-mega {{ mega.shopify_attributes }}{% endif %}>
              <a class="site-nav__link" href="{{ link.url }}" {% if mega %}aria-haspopup="true" aria-expanded="false"{% endif %}>
                {{ link.title }}
              </a>

              {%- if mega -%}
                <div class="mega" data-mega-panel>
                  <div class="mega__inner container">
                    <div class="mega__columns">
                      {%- for i in (1..3) -%}
                        {%- assign title_key = 'col' | append: i | append: '_title' -%}
                        {%- assign menu_key = 'col' | append: i | append: '_menu' -%}
                        {%- assign col_menu = linklists[mega.settings[menu_key]] -%}
                        {%- if col_menu.links.size > 0 -%}
                          <div class="mega__col">
                            <p class="mega__title">{{ mega.settings[title_key] | default: col_menu.title }}</p>
                            <ul>
                              {%- for col_link in col_menu.links -%}
                                <li><a class="mega__link" href="{{ col_link.url }}">{{ col_link.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    <div class="mega__cards">
                      {%- for i in (1..2) -%}
                        {%- assign image_key = 'card' | append: i | append: '_image' -%}
                        {%- assign title_key = 'card' | append: i | append: '_title' -%}
                        {%- assign url_key = 'card' | append: i | append: '_url' -%}
                        {%- if mega.settings[title_key] != blank -%}
                          <a class="mega-card" href="{{ mega.settings[url_key] | default: '#' }}">
                            {%- if mega.settings[image_key] != blank -%}{{ mega.settings[image_key] | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                            <span class="mega-card__label">{{ mega.settings[title_key] }} <span class="mega-card__arrow">{% render 'icon', name: 'arrow-up-right' %}</span></span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">{% render 'logo' %}</a>

    <div class="site-header__actions">
      <button class="icon-btn" type="button" data-search-open aria-label="Search">{% render 'icon', name: 'search' %}</button>
      <a class="icon-btn site-header__wish" href="{{ wishlist_url }}" aria-label="Wishlist">
        {% render 'icon', name: 'heart' %}
        <span class="icon-btn__badge" data-wishlist-count></span>
      </a>
      <button class="icon-btn" type="button" data-drawer-open="cart-drawer" aria-label="Open cart">
        {% render 'icon', name: 'bag' %}
        <span class="icon-btn__badge" data-cart-count></span>
      </button>
      <a class="icon-btn site-header__account" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
    </div>
  </div>
</header>

{%- comment -%} Search overlay {%- endcomment -%}
<div class="search" data-search hidden>
  <div class="search__panel container">
    <form class="search__form" action="{{ routes.search_url }}" role="search">
      <input type="hidden" name="type" value="product">
      <span class="search__icon">{% render 'icon', name: 'search' %}</span>
      <input class="search__input" type="search" name="q" placeholder="Search tees, hoodies, couple sets…" autocomplete="off" data-search-input>
      <button class="icon-btn icon-btn--sm" type="button" data-search-close aria-label="Close search">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search__results" data-search-results hidden></div>
    <div class="search__suggest" data-search-suggest>
      <p class="eyebrow">Trending searches</p>
      <div class="search__chips">
        {%- assign trending = section.settings.trending_searches | split: ',' -%}
        {%- for term in trending -%}
          <a class="chip-toggle" href="{{ routes.search_url }}?type=product&q={{ term | strip | url_encode }}">{% render 'icon', name: 'arrow-up-right' %}{{ term | strip }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<aside class="drawer drawer--left menu-drawer" id="menu-drawer" data-drawer aria-label="Menu" aria-hidden="true">
  <div class="drawer__head">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home" class="menu-drawer__logo">{% render 'logo' %}</a>
    <button class="icon-btn icon-btn--sm" type="button" data-drawer-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__body" data-lenis-prevent>
    {%- assign first_mega = null -%}
    {%- for link in menu.links -%}
      {%- assign mega = null -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.parent == link.title -%}{%- assign mega = block -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if mega and first_mega == null -%}{%- assign first_mega = mega -%}{%- endif -%}
      {%- if mega -%}
        <details class="accordion">
          <summary class="accordion__summary">{{ link.title }}<span class="icon">{% render 'icon', name: 'chevron-down' %}</span></summary>
          <div class="accordion__inner menu-drawer__group">
            {%- for i in (1..3) -%}
              {%- assign title_key = 'col' | append: i | append: '_title' -%}
              {%- assign menu_key = 'col' | append: i | append: '_menu' -%}
              {%- assign col_menu = linklists[mega.settings[menu_key]] -%}
              {%- if col_menu.links.size > 0 -%}
                <p class="menu-drawer__title">{{ mega.settings[title_key] | default: col_menu.title }}</p>
                {%- for col_link in col_menu.links -%}<a href="{{ col_link.url }}">{{ col_link.title }}</a>{%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </details>
      {%- else -%}
        <a class="accordion accordion__summary" href="{{ link.url }}">{{ link.title }}<span class="icon">{% render 'icon', name: 'chevron-right' %}</span></a>
      {%- endif -%}
    {%- endfor -%}

    {%- if first_mega -%}
      <div class="menu-drawer__cards">
        {%- for i in (1..2) -%}
          {%- assign image_key = 'card' | append: i | append: '_image' -%}
          {%- assign title_key = 'card' | append: i | append: '_title' -%}
          {%- assign url_key = 'card' | append: i | append: '_url' -%}
          {%- if first_mega.settings[title_key] != blank -%}
            <a class="mega-card" href="{{ first_mega.settings[url_key] | default: '#' }}">
              {%- if first_mega.settings[image_key] != blank -%}{{ first_mega.settings[image_key] | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              <span class="mega-card__label">{{ first_mega.settings[title_key] }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <div class="drawer__foot menu-drawer__foot">
    <a href="{{ routes.account_url }}">{% render 'icon', name: 'user' %} Account</a>
    <a href="{{ wishlist_url }}">{% render 'icon', name: 'heart' %} Wishlist</a>
    <a href="{{ pages['track-order'].url | default: '/pages/track-order' }}">{% render 'icon', name: 'truck' %} Track order</a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    {
      "type": "text",
      "id": "trending_searches",
      "label": "Trending searches (comma separated)",
      "default": "Oversized tees, Couple hoodies, Developer tees, Textees"
    }
  ],
  "blocks": [
    {
      "type": "mega",
      "name": "Mega menu",
      "settings": [
        { "type": "text", "id": "parent", "label": "Menu item title", "info": "Must match the top-level menu link this panel opens from, e.g. Products." },
        { "type": "text", "id": "col1_title", "label": "Column 1 heading" },
        { "type": "link_list", "id": "col1_menu", "label": "Column 1 links" },
        { "type": "text", "id": "col2_title", "label": "Column 2 heading" },
        { "type": "link_list", "id": "col2_menu", "label": "Column 2 links" },
        { "type": "text", "id": "col3_title", "label": "Column 3 heading" },
        { "type": "link_list", "id": "col3_menu", "label": "Column 3 links" },
        { "type": "header", "content": "Feature card 1" },
        { "type": "image_picker", "id": "card1_image", "label": "Image" },
        { "type": "text", "id": "card1_title", "label": "Title" },
        { "type": "url", "id": "card1_url", "label": "Link" },
        { "type": "header", "content": "Feature card 2" },
        { "type": "image_picker", "id": "card2_image", "label": "Image" },
        { "type": "text", "id": "card2_title", "label": "Title" },
        { "type": "url", "id": "card2_url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
