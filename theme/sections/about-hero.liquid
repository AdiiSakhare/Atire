{%- comment -%} About: hero with parallax image. {%- endcomment -%}
<section class="about-hero">
  <div class="about-hero__media" data-parallax>{% render 'responsive-image', image: section.settings.image, fallback: section.settings.placeholder, alt: '', width: 1600, sizes: '100vw', loading: 'eager', fetchpriority: 'high' %}</div>
  <div class="container about-hero__content">
    <p class="eyebrow about-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="about-hero__title" data-split>{{ section.settings.title }}</h1>
    <p class="about-hero__text" data-reveal>{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "title", "label": "Heading", "default": "We make tees that say the thing you were thinking." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Atire started with one oversized tee, one inside joke and a group chat that wouldn’t stop asking where it was from." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder image (asset file name or URL)" }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
