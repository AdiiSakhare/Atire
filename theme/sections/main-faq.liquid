{%- comment -%}
  Help center. Blocks are read in order: a "Group" block starts a category, and every "Question"
  block after it belongs to that group. JS hooks: data-faq, data-faq-search, data-faq-cat,
  data-faq-group, data-faq-item, data-faq-none (js/sections/content.js).
{%- endcomment -%}
<header class="page-hero page-hero--center faq-hero">
  <div class="container">
    {% render 'breadcrumb', title: 'Help Center' %}
    <p class="eyebrow page-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="page-hero__title" data-split>{{ section.settings.title }}</h1>
    <form class="faq-search" role="search" onsubmit="return false">
      <span>{% render 'icon', name: 'search' %}</span>
      <input type="search" placeholder="{{ section.settings.search_placeholder | escape }}" data-faq-search aria-label="Search FAQs" />
    </form>
  </div>
</header>

<section class="container faq" data-faq>
  <nav class="faq__cats no-scrollbar" aria-label="FAQ categories">
    <button class="chip-toggle" type="button" aria-pressed="true" data-faq-cat="all">All topics</button>
    {%- for block in section.blocks -%}{%- if block.type == 'group' -%}
      {%- assign cat_slug = block.settings.heading | handleize -%}
      <button class="chip-toggle" type="button" aria-pressed="false" data-faq-cat="{{ cat_slug }}">{% render 'icon', name: block.settings.icon %}{{ block.settings.heading }}</button>
    {%- endif -%}{%- endfor -%}
  </nav>

  <div class="faq__groups">
    {%- comment -%} Groups are built from a flat block list, so the <section> tags are emitted as strings. {%- endcomment -%}
    {%- assign group_open = false -%}
    {%- assign group_close = '</section>' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        {%- if group_open -%}{{ group_close }}{%- endif -%}
        {%- assign group_open = true -%}
        {%- assign group_slug = block.settings.heading | handleize -%}
        {%- assign group_start = '<section class="faq__group" data-faq-group="' | append: group_slug | append: '" ' | append: block.shopify_attributes | append: '>' -%}
        {{ group_start }}
        <h2 class="faq__group-title">{% render 'icon', name: block.settings.icon %} {{ block.settings.heading }}</h2>
      {%- elsif block.type == 'question' -%}
        {%- unless group_open -%}
          {%- assign group_open = true -%}
          {%- assign general_start = '<section class="faq__group" data-faq-group="general">' -%}
          {{ general_start }}
        {%- endunless -%}
        <details class="accordion" data-faq-item {{ block.shopify_attributes }}>
          <summary class="accordion__summary">{{ block.settings.question }}<span class="icon">{% render 'icon', name: 'chevron-down' %}</span></summary>
          <div class="accordion__content"><div class="accordion__inner"><p>{{ block.settings.answer }}</p></div></div>
        </details>
      {%- endif -%}
    {%- endfor -%}
    {%- if group_open -%}{{ group_close }}{%- endif -%}
    <p class="faq__none" data-faq-none hidden>No answers match that search. Try different words — or ask us directly below.</p>
  </div>

  <div class="faq__cta">
    <div><h2 class="h-display-sm">{{ section.settings.cta_title }}</h2><p class="text-muted">{{ section.settings.cta_text }}</p></div>
    <div class="faq__cta-btns">
      {%- if section.settings.whatsapp_url != blank -%}
        <a class="btn btn--primary btn--lg" href="{{ section.settings.whatsapp_url }}">{% render 'icon', name: 'bolt' %} {{ section.settings.whatsapp_label }}</a>
      {%- endif -%}
      {%- if section.settings.contact_url != blank -%}
        <a class="btn btn--outline btn--lg" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Help center (FAQ)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help Center" },
    { "type": "text", "id": "title", "label": "Heading", "default": "How can we help?" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search “returns”, “COD”, “size”…" },
    { "type": "header", "content": "Still need help? banner" },
    { "type": "text", "id": "cta_title", "label": "Heading", "default": "Still need help?" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Real humans, real fast. Mon–Sat, 10 AM – 7 PM." },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "WhatsApp us" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp button link" },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact form" },
    { "type": "url", "id": "contact_url", "label": "Contact button link" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Group heading", "default": "Orders & Shipping", "info": "Questions below this block (until the next group) belong to it. Drag blocks to reorder." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "ruler", "label": "Ruler" }, { "value": "cash", "label": "Cash" },
          { "value": "shield", "label": "Shield" }, { "value": "tag", "label": "Tag" }, { "value": "heart", "label": "Heart" }, { "value": "bolt", "label": "Bolt" },
          { "value": "bag", "label": "Bag" }, { "value": "user", "label": "User" }
        ] }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "Help center (FAQ)", "blocks": [{ "type": "group" }, { "type": "question" }, { "type": "question" }] }
  ]
}
{% endschema %}
