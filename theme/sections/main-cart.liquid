{%- comment -%}
  Cart page. Line items and totals are rendered by js/sections/cart-page.js from the live cart
  (same store as the drawer). Checkout is Shopify's native checkout.
{%- endcomment -%}
<section class="container cart-page" data-cart-page>
  <div class="checkout-steps" aria-label="Checkout progress">
    <span class="is-active">1 · Cart</span><span>2 · Details</span><span>3 · Payment</span>
  </div>

  <div class="cart-page__head">
    <h1 class="page-hero__title">Your Cart <span class="cart-page__count" data-cp-count></span></h1>
    <a class="section-head__link" href="{{ routes.all_products_collection_url }}">Continue shopping<span>{% render 'icon', name: 'arrow-up-right' %}</span></a>
  </div>

  <div class="cart-page__ship" data-cp-ship>
    <p data-cp-ship-text></p>
    <div class="cart-drawer__ship-bar"><span data-cp-ship-bar></span></div>
  </div>

  <div class="cart-page__layout" data-cp-layout>
    <div class="cart-page__items">
      <ul class="cart-page__list" data-cp-items></ul>
      <div class="cart-page__notes">
        <p>{% render 'icon', name: 'shield' %} {{ section.settings.reserve_note }}</p>
      </div>
    </div>

    <aside class="summary" data-cp-summary>
      <div class="summary__coupon">
        <p class="summary__title">{% render 'icon', name: 'tag' %} Apply coupon</p>
        <form class="field" data-coupon-form>
          <label class="visually-hidden" for="coupon">Coupon code</label>
          <input class="field__input" id="coupon" name="coupon" placeholder="Enter code" autocomplete="off">
          <button class="field__action" type="submit">Apply</button>
        </form>
        <p class="summary__msg" data-coupon-msg aria-live="polite"></p>
        <div class="summary__offers" data-coupon-offers>
          {%- for block in section.blocks -%}{%- if block.type == 'offer' -%}
            <button class="offer-chip" type="button" data-offer="{{ block.settings.code }}" {{ block.shopify_attributes }}><strong>{{ block.settings.code }}</strong><span>{{ block.settings.label }}</span><em>Apply</em></button>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>

      <div class="summary__box">
        <p class="summary__title">Price details</p>
        <dl class="summary__rows" data-summary-rows></dl>
        <p class="summary__savings" data-summary-savings></p>
        <a class="btn btn--primary btn--block btn--lg" href="{{ routes.root_url }}checkout" data-cp-checkout>Proceed to Checkout</a>
        <ul class="summary__trust">
          <li>{% render 'icon', name: 'shield' %} 100% secure payments</li>
          <li>{% render 'icon', name: 'return' %} 7-day easy returns</li>
          <li>{% render 'icon', name: 'cash' %} COD available</li>
        </ul>
      </div>
    </aside>
  </div>

  <div class="cart-page__empty" data-cp-empty hidden>
    {%- assign empty_url = section.settings.empty_url | default: routes.all_products_collection_url -%}
    {% render 'empty-state', icon: 'bag', title: 'Your cart is feeling a little empty', text: 'Let’s fix that. Our bestsellers are a great place to start.', cta: 'Shop Bestsellers', url: empty_url %}
  </div>
</section>

<div class="cart-mobile-bar" data-cp-mobile-bar>
  <div><small>Total</small><strong data-cp-mobile-total></strong></div>
  <a class="btn btn--primary btn--lg" href="{{ routes.root_url }}checkout">Checkout</a>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "text", "id": "reserve_note", "label": "Reminder under the items", "default": "Items in your cart aren’t reserved — checkout soon to avoid missing your size." },
    { "type": "url", "id": "empty_url", "label": "Empty-cart button link" }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer chip",
      "settings": [
        { "type": "text", "id": "code", "label": "Discount code", "default": "PREPAID100" },
        { "type": "text", "id": "label", "label": "Description", "default": "₹100 off prepaid orders above ₹1,199" }
      ]
    }
  ]
}
{% endschema %}
