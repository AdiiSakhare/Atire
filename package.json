{
  "name": "atire-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:theme": "vite build --config vite.theme.config.js && node scripts/copy-theme-placeholders.mjs",
    "preview": "vite preview",
    "theme:dev": "shopify theme dev --path theme",
    "theme:check": "shopify theme check --path theme",
    "shopify:products": "node scripts/export-shopify-products.mjs",
    "theme:seed": "node scripts/seed-theme-templates.mjs",
    "theme:icons": "node scripts/build-icon-snippet.mjs",
    "images": "node scripts/extract-placeholders.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "^4.8.4",
    "handlebars": "^4.7.9",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vite-plugin-handlebars": "^2.0.3"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  }
}
